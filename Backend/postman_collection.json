{
  "info": {
    "name": "QRCard API",
    "description": "QRCard — QR-Based Digital Visiting Card Platform\nBase URL: {{baseUrl}}\n\nSet these collection variables:\n- baseUrl: https://backend-onrender-qbu7.onrender.com/api\n- token: JWT from login response (auto-filled by Login test script)",
    "version": "2.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://backend-onrender-qbu7.onrender.com/api", "type": "string" },
    { "key": "token",   "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/../health", "host": ["{{baseUrl}}"], "path": ["..","health"] },
            "description": "Confirms the API server is running."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register — Request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register/request-otp", "host": ["{{baseUrl}}"], "path": ["auth","register","request-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"username\": \"john_doe\",\n  \"password\": \"MyPass123!\",\n  \"recaptchaToken\": \"<recaptcha_token>\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Step 1 of registration. Validates credentials and sends a 6-digit OTP to the email. reCAPTCHA required."
          }
        },
        {
          "name": "Register — Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth","register","verify-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Step 2 of registration. Verifies the 6-digit OTP and creates the user account (is_verified: true). Returns JWT + user object."
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const r=pm.response.json(); if(r.data&&r.data.token){ pm.collectionVariables.set('token',r.data.token); console.log('Token saved'); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"MyPass123!\",\n  \"recaptchaToken\": \"<recaptcha_token>\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Email/password login. JWT is auto-saved to `token` collection variable via test script. reCAPTCHA required."
          }
        },
        {
          "name": "Google OAuth Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/google", "host": ["{{baseUrl}}"], "path": ["auth","google"] },
            "body": { "mode": "raw", "raw": "{\n  \"credential\": \"<google_id_token>\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Authenticate via Google Sign-In ID token. Creates account automatically if new user. Returns JWT."
          }
        },
        {
          "name": "Google Pre-flight Check",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/google-check", "host": ["{{baseUrl}}"], "path": ["auth","google-check"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@gmail.com\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Pre-flight check before Google login. Returns { exists: bool, hasPassword: bool }."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth","forgot-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"recaptchaToken\": \"<recaptcha_token>\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Sends a password reset OTP to the email. OTP valid for 10 minutes. Response is vague to prevent email enumeration."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth","verify-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"123456\",\n  \"purpose\": \"PASSWORD_RESET\",\n  \"recaptchaToken\": \"<recaptcha_token>\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Verifies OTP. purpose: REGISTRATION or PASSWORD_RESET.\nFor PASSWORD_RESET: returns { data: { reset_token } } — valid 15 minutes, use in Reset Password endpoint."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth","reset-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"<reset_token_from_verify_otp>\",\n  \"password\": \"NewPass123!\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Completes password reset. Use the reset_token returned by POST /auth/verify-otp. Token expires in 15 minutes."
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["auth","resend-otp"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"purpose\": \"REGISTRATION\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Resends an OTP. purpose: REGISTRATION or PASSWORD_RESET."
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth","me"] },
            "description": "Returns authenticated user: id, email, username, role, is_verified, is_active, created_at. Requires JWT."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth","change-password"] },
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"OldPass123!\",\n  \"newPassword\": \"NewPass456!\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Changes password. Fails if account was created via Google (no password_hash). Requires auth."
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Public Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/profile/public/rajanhok", "host": ["{{baseUrl}}"], "path": ["profile","public","rajanhok"] },
            "description": "Public QR card profile page by username. No auth. Increments scan_count on the user's Online QR."
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] },
            "description": "Returns full profile including completeness_score (0–100), social_links, and is_public flag."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] },
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"John Carter\",\n  \"job_title\": \"Backend Developer\",\n  \"company\": \"QRCard Nepal\",\n  \"bio\": \"Passionate engineer building scalable systems.\",\n  \"phone\": \"+977-9800000000\",\n  \"public_email\": \"john@example.com\",\n  \"website\": \"https://johncarter.dev\",\n  \"address\": \"Kathmandu, Nepal\",\n  \"is_public\": true,\n  \"social_links\": {\n    \"linkedin\": \"https://linkedin.com/in/johncarter\",\n    \"github\": \"https://github.com/johncarter\",\n    \"twitter\": \"\",\n    \"instagram\": \"\",\n    \"facebook\": \"\"\n  }\n}", "options": { "raw": { "language": "json" } } },
            "description": "Updates profile. All fields optional. Setting is_public: false hides profile from QR scan (returns 404 on public route)."
          }
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/profile/avatar", "host": ["{{baseUrl}}"], "path": ["profile","avatar"] },
            "body": { "mode": "formdata", "formdata": [{ "key": "avatar", "type": "file", "src": "" }] },
            "description": "Upload avatar image (multipart/form-data, field name: avatar). Updates avatar_url on profile."
          }
        },
        {
          "name": "Delete Avatar",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/profile/avatar", "host": ["{{baseUrl}}"], "path": ["profile","avatar"] },
            "description": "Removes avatar and clears avatar_url on the profile."
          }
        }
      ]
    },
    {
      "name": "QR Codes",
      "item": [
        {
          "name": "Generate Online QR",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/qr/online", "host": ["{{baseUrl}}"], "path": ["qr","online"] },
            "description": "Generates Online QR encoding qrcard.dev/u/{username}. Upserts — safe to call multiple times."
          }
        },
        {
          "name": "Generate Offline vCard QR",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/qr/offline", "host": ["{{baseUrl}}"], "path": ["qr","offline"] },
            "description": "Generates Offline QR embedding vCard contact data. Works without internet — receivers can save contact directly."
          }
        },
        {
          "name": "Get All QR Codes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/qr", "host": ["{{baseUrl}}"], "path": ["qr"] },
            "description": "Returns { online: {..., scan_count}, offline: {...} } for the authenticated user."
          }
        },
        {
          "name": "Delete QR Code",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/qr/ONLINE", "host": ["{{baseUrl}}"], "path": ["qr","ONLINE"] },
            "description": "Deletes a QR code. URL param: ONLINE or OFFLINE."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Print Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "body": { "mode": "raw", "raw": "{\n  \"design_config\": {\n    \"template\": \"Minimal\",\n    \"primary_color\": \"#6366f1\",\n    \"secondary_color\": \"#ffffff\",\n    \"show_avatar\": true,\n    \"font\": \"inter\",\n    \"layout\": \"standard\",\n    \"font_style\": \"modern\",\n    \"corner_style\": \"rounded\",\n    \"show_logo\": true,\n    \"theme_color\": \"#6366f1\",\n    \"card_qr_type\": \"BOTH\"\n  },\n  \"qr_type\": \"ONLINE\",\n  \"quantity\": 100,\n  \"notes\": \"Name: John Carter. Paper: Premium. Address: Kathmandu, Nepal. Phone: 9800000000.\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Places a new print order. A QR code of the specified qr_type must exist. Status starts as PENDING."
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/orders?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["orders"], "query": [{"key":"page","value":"1"},{"key":"limit","value":"10"},{"key":"status","value":"","disabled":true}] },
            "description": "Lists user's own orders. Filter by status: PENDING, CONFIRMED, PROCESSING, DELIVERED, COMPLETED, CANCELLED."
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/orders/<order_uuid>", "host": ["{{baseUrl}}"], "path": ["orders","<order_uuid>"] },
            "description": "Get single order by UUID. Scoped to authenticated user."
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/orders/<order_uuid>/cancel", "host": ["{{baseUrl}}"], "path": ["orders","<order_uuid>","cancel"] },
            "description": "Cancels an order. Only PENDING orders can be cancelled by the user."
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Generate AI Bio",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/ai/bio", "host": ["{{baseUrl}}"], "path": ["ai","bio"] },
            "description": "Uses Groq AI (llama-3.3-70b-versatile) to auto-generate a professional bio from profile data. Rate limited: 10 req/15min. Requires full_name and job_title to be set."
          }
        },
        {
          "name": "Get Completeness Suggestions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/ai/completeness", "host": ["{{baseUrl}}"], "path": ["ai","completeness"] },
            "description": "Returns AI-powered profile improvement suggestions. Response: { score, level, missing_fields[], suggestions[] }. Rate limited."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin","dashboard"] },
            "description": "Returns: total_users, active_users, orders { pending, confirmed, completed, cancelled }, recent_orders (last 5)."
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin","users"] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"new_user\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"TempPass123!\",\n  \"role\": \"USER\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Creates user or admin account directly. is_verified: true automatically. role: USER or ADMIN."
          }
        },
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["admin","users"], "query": [{"key":"page","value":"1"},{"key":"limit","value":"20"}] },
            "description": "All users with profile completion %, order count, role, status. Paginated (default limit 20, max 50)."
          }
        },
        {
          "name": "Get User Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users/<user_uuid>", "host": ["{{baseUrl}}"], "path": ["admin","users","<user_uuid>"] },
            "description": "Full user details including profile and order history."
          }
        },
        {
          "name": "Block / Unblock User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users/<user_uuid>/status", "host": ["{{baseUrl}}"], "path": ["admin","users","<user_uuid>","status"] },
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": false\n}", "options": { "raw": { "language": "json" } } },
            "description": "is_active: false = block (user cannot login). is_active: true = unblock."
          }
        },
        {
          "name": "List All Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/orders?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["admin","orders"], "query": [{"key":"page","value":"1"},{"key":"limit","value":"20"},{"key":"status","value":"","disabled":true}] },
            "description": "All orders across all users. Filter by status: PENDING, CONFIRMED, PROCESSING, DELIVERED, COMPLETED, CANCELLED."
          }
        },
        {
          "name": "Get Order Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/orders/<order_uuid>", "host": ["{{baseUrl}}"], "path": ["admin","orders","<order_uuid>"] },
            "description": "Full order details including user info and vendor assignment."
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/orders/<order_uuid>/status", "host": ["{{baseUrl}}"], "path": ["admin","orders","<order_uuid>","status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Valid transitions:\nPENDING → CONFIRMED | CANCELLED\nCONFIRMED → PROCESSING | CANCELLED\nPROCESSING → DELIVERED\nDELIVERED → COMPLETED\n\nCONFIRMED sends customer email with PDF card preview."
          }
        },
        {
          "name": "Assign Order to Vendor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/orders/<order_uuid>/send-to-vendor", "host": ["{{baseUrl}}"], "path": ["admin","orders","<order_uuid>","send-to-vendor"] },
            "body": { "mode": "raw", "raw": "{\n  \"vendor_id\": \"<vendor_uuid>\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Assigns order to vendor → auto-sets status to PROCESSING → sends vendor email with PDF + SVG card design."
          }
        },
        {
          "name": "Create Vendor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/vendors", "host": ["{{baseUrl}}"], "path": ["admin","vendors"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"PrintShop Nepal\",\n  \"email\": \"vendor@printshop.com\",\n  \"phone\": \"+977-9811111111\",\n  \"address\": \"New Road, Kathmandu\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Creates a print vendor. email must be unique."
          }
        },
        {
          "name": "List Vendors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/vendors", "host": ["{{baseUrl}}"], "path": ["admin","vendors"] },
            "description": "All vendors including active/inactive status."
          }
        },
        {
          "name": "Get Vendor",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/vendors/<vendor_uuid>", "host": ["{{baseUrl}}"], "path": ["admin","vendors","<vendor_uuid>"] },
            "description": "Single vendor details."
          }
        },
        {
          "name": "Update Vendor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/vendors/<vendor_uuid>", "host": ["{{baseUrl}}"], "path": ["admin","vendors","<vendor_uuid>"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"PrintShop Nepal Updated\",\n  \"phone\": \"+977-9822222222\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Partial update. All fields optional."
          }
        },
        {
          "name": "Deactivate Vendor",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/vendors/<vendor_uuid>", "host": ["{{baseUrl}}"], "path": ["admin","vendors","<vendor_uuid>"] },
            "description": "Soft-deactivates vendor (is_active: false). Not a hard delete."
          }
        }
      ]
    }
  ]
}
